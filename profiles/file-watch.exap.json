{
  "profile_id": "profile:file-watch",
  "exap_version": "0.2.0-draft",
  "name": "File Watch",
  "description": "Monitor file creation, modification, growth, and readiness.",
  "domain": "file",
  "subject_types": [
    "file",
    "directory"
  ],
  "signals": [
    "file.exists",
    "file.size.bytes",
    "file.modified_age.seconds"
  ],
  "event_types": [
    "file.created",
    "file.modified"
  ],
  "rules": [
    {
      "rule_id": "rule_expected_file_ready",
      "name": "expected_file_ready",
      "description": "An expected file exists and is stable.",
      "condition": {
        "type": "all",
        "conditions": [
          {
            "type": "signal",
            "signal": "file.exists",
            "operator": "eq",
            "value": true
          },
          {
            "type": "signal",
            "signal": "file.size.bytes",
            "operator": "gt",
            "value": 0
          },
          {
            "type": "signal",
            "signal": "file.modified_age.seconds",
            "operator": "gte",
            "value": 30
          }
        ]
      },
      "severity": "info",
      "delivery_action": "include_in_summary",
      "cooldown": "PT5M",
      "evidence": {
        "include": [
          "matched_values",
          "subject_snapshot"
        ],
        "max_items": 4,
        "max_excerpt_chars": 500,
        "include_subject_attributes": true
      }
    }
  ],
  "delivery": {
    "modes": [
      "blocking_wait",
      "push",
      "stream"
    ],
    "return_policy": {
      "default_action": "record_only",
      "by_severity": {
        "info": "include_in_summary",
        "notice": "deliver",
        "warning": "deliver_and_interrupt_wait",
        "critical": "deliver_and_interrupt_wait",
        "emergency": "deliver_and_interrupt_wait"
      }
    }
  },
  "privacy": {
    "purpose": "environment_attention",
    "data_minimization": true,
    "allowed_fields": [
      "subject.ref",
      "subject.type",
      "evidence.stats",
      "evidence.value",
      "payload.summary"
    ],
    "forbidden_fields": [
      "secret",
      "token",
      "password",
      "credential",
      "payload.raw_body",
      "payload.attachment.content"
    ],
    "redaction": {
      "mode": "summary_only",
      "include_redaction_report": true,
      "rules": []
    },
    "retention": {
      "observations": "PT24H",
      "events": "P7D",
      "audit_logs": "P30D"
    },
    "audit": {
      "enabled": true,
      "user_visible": true,
      "log_fields": [
        "contract_id",
        "attention_id",
        "rule_id",
        "delivery_action"
      ]
    },
    "data_classes": [
      "operational_metadata"
    ]
  },
  "parameters": []
}
