{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exap.dev/schemas/exap-attention-contract.schema.json",
  "title": "ExAP Attention Contract",
  "type": "object",
  "required": [
    "exap_version",
    "consumer",
    "intent",
    "scope",
    "rules",
    "delivery",
    "privacy"
  ],
  "additionalProperties": false,
  "properties": {
    "exap_version": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/ExAPVersion"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^act_[A-Za-z0-9_-]+$"
    },
    "created_at": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/DateTime"
    },
    "updated_at": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/DateTime"
    },
    "created_by": {
      "type": "string"
    },
    "consumer": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Consumer"
    },
    "provider": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Provider"
    },
    "environment": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Environment"
    },
    "environment_ref": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/ExAPUri"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://exap.dev/schemas/exap-rule.schema.json"
      }
    },
    "delivery": {
      "$ref": "#/$defs/Delivery"
    },
    "privacy": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/PrivacyPolicy"
    },
    "lifecycle": {
      "$ref": "#/$defs/Lifecycle"
    },
    "state_policy": {
      "$ref": "#/$defs/StatePolicy"
    },
    "memory": {
      "$ref": "#/$defs/MemoryPolicy"
    },
    "integrations": {
      "$ref": "#/$defs/IntegrationHints"
    },
    "metadata": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/ExtensionMap"
    }
  },
  "$defs": {
    "Scope": {
      "type": "object",
      "required": [
        "subjects"
      ],
      "additionalProperties": false,
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SubjectSelector"
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "time_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "labels": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/KeyValue"
        }
      }
    },
    "SubjectSelector": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "ref": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/ExAPUri"
        },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "include_children": {
          "type": "boolean"
        },
        "relationship": {
          "type": "string"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "exact",
            "dynamic",
            "snapshot"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "ref"
          ]
        },
        {
          "required": [
            "match"
          ]
        }
      ]
    },
    "TimeWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "starts_at": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/DateTime"
        },
        "ends_at": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/DateTime"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "Delivery": {
      "type": "object",
      "required": [
        "modes",
        "transports",
        "return_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "blocking_wait",
              "push",
              "stream",
              "pull_with_state_compression"
            ]
          },
          "uniqueItems": true
        },
        "transports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transport"
          }
        },
        "return_policy": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/ReturnPolicy"
        },
        "dedupe": {
          "$ref": "#/$defs/Dedupe"
        },
        "retry": {
          "$ref": "#/$defs/Retry"
        },
        "ack": {
          "$ref": "#/$defs/AckPolicy"
        },
        "payload_limits": {
          "$ref": "#/$defs/PayloadLimits"
        }
      }
    },
    "Transport": {
      "type": "object",
      "required": [
        "transport",
        "mode",
        "content_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "transport": {
          "type": "string",
          "enum": [
            "http",
            "http_webhook",
            "sse",
            "websocket",
            "mqtt",
            "nats",
            "kafka",
            "local_stdio",
            "local_socket",
            "mcp",
            "a2a"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "blocking_wait",
            "push",
            "stream",
            "pull_with_state_compression"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "content_mode": {
          "type": "string",
          "enum": [
            "structured",
            "binary"
          ]
        },
        "auth_ref": {
          "type": "string"
        },
        "metadata": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/ExtensionMap"
        }
      }
    },
    "Dedupe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "window": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Duration"
        }
      }
    },
    "Retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "backoff": {
          "type": "string",
          "enum": [
            "none",
            "fixed",
            "exponential"
          ]
        },
        "initial_delay": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Duration"
        },
        "max_delay": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Duration"
        }
      }
    },
    "AckPolicy": {
      "type": "object",
      "required": [
        "required",
        "deadline"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "deadline": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Duration"
        },
        "snooze_allowed": {
          "type": "boolean"
        }
      }
    },
    "PayloadLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_event_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_evidence_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_text_chars": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Status"
        },
        "starts_at": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/DateTime"
        },
        "expires_at": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/DateTime"
        },
        "max_runtime": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Duration"
        },
        "auto_revoke_on_completion": {
          "type": "boolean"
        }
      }
    },
    "StatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_observations": {
          "type": "boolean"
        },
        "store_events": {
          "type": "boolean"
        },
        "checkpoint_interval": {
          "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/Duration"
        }
      }
    },
    "MemoryPolicy": {
      "type": "object",
      "required": [
        "allowed",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "enum": [
            "none",
            "session",
            "project",
            "user",
            "organization"
          ]
        },
        "allowed_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "IntegrationHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "object",
          "additionalProperties": true
        },
        "a2a": {
          "type": "object",
          "additionalProperties": true
        },
        "opentelemetry": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
