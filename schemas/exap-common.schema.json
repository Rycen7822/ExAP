{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json",
  "title": "ExAP Common Definitions",
  "type": "object",
  "$defs": {
    "ExAPVersion": {
      "const": "0.2.0-draft"
    },
    "ExAPUri": {
      "type": "string",
      "pattern": "^exap://[a-z0-9][a-z0-9._-]*/[a-z][a-z0-9._-]*/[^\\s]+$"
    },
    "DateTime": {
      "type": "string",
      "format": "date-time"
    },
    "Duration": {
      "type": "string",
      "pattern": "^P(?=\\d|T\\d)(?:(\\d+)Y)?(?:(\\d+)M)?(?:(\\d+)W)?(?:(\\d+)D)?(?:T(?=\\d)(?:(\\d+)H)?(?:(\\d+)M)?(?:(\\d+(?:\\.\\d+)?)S)?)?$"
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "notice",
        "warning",
        "critical",
        "emergency"
      ]
    },
    "Sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "secret",
        "restricted"
      ]
    },
    "DeliveryAction": {
      "type": "string",
      "enum": [
        "record_only",
        "include_in_summary",
        "deliver",
        "deliver_and_interrupt_wait"
      ]
    },
    "Status": {
      "$ref": "#/$defs/LifecycleStatus"
    },
    "KeyValue": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "ExtensionMap": {
      "type": "object",
      "additionalProperties": true
    },
    "Consumer": {
      "type": "object",
      "required": [
        "consumer_id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "consumer_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "agent",
            "application",
            "service",
            "user_interface",
            "automation",
            "human_proxy",
            "custom"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/ExtensionMap"
        },
        "auth_context": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "$ref": "#/$defs/ExtensionMap"
        }
      }
    },
    "Provider": {
      "type": "object",
      "required": [
        "provider_id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "local_daemon",
            "connector",
            "monitoring_service",
            "broker",
            "iot_gateway",
            "cloud_service",
            "agent_runtime",
            "custom"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "capability_ref": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ExtensionMap"
        }
      }
    },
    "Environment": {
      "type": "object",
      "required": [
        "ref",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/ExAPUri"
        },
        "kind": {
          "type": "string",
          "enum": [
            "personal",
            "project",
            "machine",
            "home",
            "enterprise",
            "cloud",
            "lab",
            "service",
            "custom"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "owner_ref": {
          "$ref": "#/$defs/ExAPUri"
        },
        "timezone": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/KeyValue"
        },
        "metadata": {
          "$ref": "#/$defs/ExtensionMap"
        }
      }
    },
    "Subject": {
      "type": "object",
      "required": [
        "ref",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/ExAPUri"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "environment_ref": {
          "$ref": "#/$defs/ExAPUri"
        },
        "display_name": {
          "type": "string"
        },
        "parent_ref": {
          "$ref": "#/$defs/ExAPUri"
        },
        "attributes": {
          "$ref": "#/$defs/ExtensionMap"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "metadata": {
          "$ref": "#/$defs/ExtensionMap"
        }
      }
    },
    "ReturnPolicy": {
      "type": "object",
      "required": [
        "default_action",
        "by_severity"
      ],
      "additionalProperties": false,
      "properties": {
        "default_action": {
          "$ref": "#/$defs/DeliveryAction"
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "info": {
              "$ref": "#/$defs/DeliveryAction"
            },
            "notice": {
              "$ref": "#/$defs/DeliveryAction"
            },
            "warning": {
              "$ref": "#/$defs/DeliveryAction"
            },
            "critical": {
              "$ref": "#/$defs/DeliveryAction"
            },
            "emergency": {
              "$ref": "#/$defs/DeliveryAction"
            }
          }
        }
      }
    },
    "PrivacyPolicy": {
      "type": "object",
      "required": [
        "purpose",
        "data_minimization",
        "forbidden_fields",
        "redaction",
        "retention",
        "audit"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "data_minimization": {
          "type": "boolean"
        },
        "allowed_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "forbidden_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "redaction": {
          "type": "object",
          "required": [
            "mode",
            "include_redaction_report"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "mask",
                "hash",
                "summary_only",
                "drop"
              ]
            },
            "include_redaction_report": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "retention": {
          "type": "object",
          "required": [
            "observations",
            "events",
            "audit_logs"
          ],
          "additionalProperties": false,
          "properties": {
            "observations": {
              "$ref": "#/$defs/Duration"
            },
            "events": {
              "$ref": "#/$defs/Duration"
            },
            "audit_logs": {
              "$ref": "#/$defs/Duration"
            }
          }
        },
        "audit": {
          "type": "object",
          "required": [
            "enabled",
            "user_visible"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "user_visible": {
              "type": "boolean"
            },
            "log_fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "consent_ref": {
          "type": "string"
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "PrivacyReport": {
      "type": "object",
      "required": [
        "purpose",
        "data_minimization_applied",
        "fields_included",
        "fields_redacted",
        "retention"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string"
        },
        "data_minimization_applied": {
          "type": "boolean"
        },
        "fields_included": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "fields_redacted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "retention": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Duration"
          }
        },
        "redaction_report": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "TraceContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        },
        "parent_span_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        }
      }
    },
    "CurrentExAPVersion": {
      "const": "0.2.0-draft"
    },
    "DeliveryMode": {
      "type": "string",
      "enum": [
        "blocking_wait",
        "push",
        "stream",
        "pull_with_state_compression"
      ]
    },
    "TransportKind": {
      "type": "string",
      "enum": [
        "http",
        "http_webhook",
        "sse",
        "websocket",
        "mqtt",
        "nats",
        "kafka",
        "local_stdio",
        "local_socket",
        "mcp",
        "a2a"
      ]
    },
    "BindingKind": {
      "type": "string",
      "enum": [
        "http",
        "webhook",
        "sse",
        "websocket",
        "mqtt",
        "nats",
        "kafka",
        "local_stdio",
        "local_socket",
        "mcp",
        "a2a"
      ]
    },
    "ContentMode": {
      "type": "string",
      "enum": [
        "structured",
        "binary"
      ]
    },
    "SignalOperator": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "gt",
        "gte",
        "lt",
        "lte",
        "exists",
        "not_exists",
        "changed",
        "unchanged",
        "regex",
        "contains",
        "in",
        "not_in",
        "rate_gt",
        "rate_lt",
        "relative_change_gt",
        "relative_change_lt",
        "relative_drop_gt",
        "semantic_match"
      ]
    },
    "EventOperator": {
      "type": "string",
      "enum": [
        "exists",
        "count_eq",
        "count_gt",
        "count_gte",
        "count_lt",
        "count_lte",
        "field_eq",
        "field_regex",
        "field_contains",
        "semantic_match"
      ]
    },
    "FieldOperator": {
      "type": "string",
      "enum": [
        "eq",
        "ne",
        "regex",
        "contains",
        "in",
        "not_in",
        "semantic_match"
      ]
    },
    "RuleOperator": {
      "type": "string",
      "enum": [
        "changed",
        "contains",
        "count_eq",
        "count_gt",
        "count_gte",
        "count_lt",
        "count_lte",
        "eq",
        "exists",
        "field_contains",
        "field_eq",
        "field_regex",
        "gt",
        "gte",
        "in",
        "lt",
        "lte",
        "ne",
        "not_exists",
        "not_in",
        "rate_gt",
        "rate_lt",
        "regex",
        "relative_change_gt",
        "relative_change_lt",
        "relative_drop_gt",
        "semantic_match",
        "unchanged"
      ]
    },
    "Aggregate": {
      "type": "string",
      "enum": [
        "last",
        "min",
        "max",
        "avg",
        "sum",
        "count",
        "p50",
        "p90",
        "p95",
        "p99",
        "delta",
        "rate"
      ]
    },
    "ReturnReason": {
      "type": "string",
      "enum": [
        "attention",
        "summary",
        "timeout",
        "revoked",
        "expired",
        "completed",
        "provider_error",
        "interrupted"
      ]
    },
    "WaitInclude": {
      "type": "string",
      "enum": [
        "event",
        "state",
        "summary"
      ]
    },
    "AckAction": {
      "type": "string",
      "enum": [
        "seen",
        "snooze",
        "dismiss",
        "escalate"
      ]
    },
    "LifecycleStatus": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "revoked",
        "expired",
        "completed",
        "failed"
      ]
    },
    "ExAPErrorCode": {
      "type": "string",
      "pattern": "^ExAP-[0-9]{4}$"
    }
  }
}
