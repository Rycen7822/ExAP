{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exap.dev/schemas/0.2.0-draft/exap-lifecycle-message.schema.json",
  "title": "ExAP Lifecycle API Message",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Request": {
      "oneOf": [
        {
          "$ref": "#/$defs/DiscoverRequest"
        },
        {
          "$ref": "#/$defs/ContractCreateRequest"
        },
        {
          "$ref": "#/$defs/ContractGetRequest"
        },
        {
          "$ref": "#/$defs/ContractListRequest"
        },
        {
          "$ref": "#/$defs/ContractUpdateRequest"
        },
        {
          "$ref": "#/$defs/ContractPauseRequest"
        },
        {
          "$ref": "#/$defs/ContractResumeRequest"
        },
        {
          "$ref": "#/$defs/ContractRevokeRequest"
        },
        {
          "$ref": "#/$defs/WaitRequest"
        },
        {
          "$ref": "#/$defs/StreamOpenRequest"
        },
        {
          "$ref": "#/$defs/AttentionAckRequest"
        },
        {
          "$ref": "#/$defs/StatusRequest"
        },
        {
          "$ref": "#/$defs/ObservationQueryRequest"
        }
      ]
    },
    "DiscoverRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.discover"
        },
        "params": {
          "$ref": "#/$defs/DiscoverParams"
        }
      }
    },
    "ContractCreateRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.contract.create"
        },
        "params": {
          "$ref": "#/$defs/ContractCreateParams"
        }
      }
    },
    "ContractGetRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.contract.get"
        },
        "params": {
          "$ref": "#/$defs/ContractGetParams"
        }
      }
    },
    "ContractListRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.contract.list"
        },
        "params": {
          "$ref": "#/$defs/ContractListParams"
        }
      }
    },
    "ContractUpdateRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.contract.update"
        },
        "params": {
          "$ref": "#/$defs/ContractUpdateParams"
        }
      }
    },
    "ContractPauseRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.contract.pause"
        },
        "params": {
          "$ref": "#/$defs/ContractPauseParams"
        }
      }
    },
    "ContractResumeRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.contract.resume"
        },
        "params": {
          "$ref": "#/$defs/ContractResumeParams"
        }
      }
    },
    "ContractRevokeRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.contract.revoke"
        },
        "params": {
          "$ref": "#/$defs/ContractRevokeParams"
        }
      }
    },
    "WaitRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.wait"
        },
        "params": {
          "$ref": "#/$defs/WaitParams"
        }
      }
    },
    "StreamOpenRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.stream.open"
        },
        "params": {
          "$ref": "#/$defs/StreamOpenParams"
        }
      }
    },
    "AttentionAckRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.attention.ack"
        },
        "params": {
          "$ref": "#/$defs/AttentionAckParams"
        }
      }
    },
    "StatusRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.status"
        },
        "params": {
          "$ref": "#/$defs/StatusParams"
        }
      }
    },
    "ObservationQueryRequest": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "method": {
          "const": "exap.observation.query"
        },
        "params": {
          "$ref": "#/$defs/ObservationQueryParams"
        }
      }
    },
    "Response": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/DiscoverResult"
            },
            {
              "$ref": "#/$defs/ContractCreateResult"
            },
            {
              "$ref": "#/$defs/ContractGetResult"
            },
            {
              "$ref": "#/$defs/ContractListResult"
            },
            {
              "$ref": "#/$defs/ContractUpdateResult"
            },
            {
              "$ref": "#/$defs/ContractPauseResult"
            },
            {
              "$ref": "#/$defs/ContractResumeResult"
            },
            {
              "$ref": "#/$defs/ContractRevokeResult"
            },
            {
              "$ref": "#/$defs/WaitResult"
            },
            {
              "$ref": "#/$defs/StreamOpenResult"
            },
            {
              "$ref": "#/$defs/AttentionAckResult"
            },
            {
              "$ref": "#/$defs/StatusResult"
            },
            {
              "$ref": "#/$defs/ObservationQueryResult"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ]
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "exap_code": {
              "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExAPErrorCode"
            },
            "field": {
              "type": "string"
            }
          },
          "required": [
            "exap_code"
          ]
        }
      }
    },
    "DiscoverParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment_ref": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExAPUri"
        },
        "subject_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "profile_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "include_examples": {
          "type": "boolean"
        }
      }
    },
    "ContractCreateParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-attention-contract.schema.json"
        },
        "validate_only": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract"
      ]
    },
    "ContractGetParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "include_state": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_id"
      ]
    },
    "ContractListParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consumer_id": {
          "type": "string"
        },
        "status": {
          "type": "array",
          "items": {
            "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/LifecycleStatus"
          },
          "uniqueItems": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": []
    },
    "ContractUpdateParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "patch": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "expected_version": {
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "patch"
      ]
    },
    "ContractPauseParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_id",
        "reason"
      ]
    },
    "ContractResumeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_id",
        "reason"
      ]
    },
    "ContractRevokeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contract_id",
        "reason"
      ]
    },
    "WaitParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "until": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ReturnReason"
          },
          "uniqueItems": true
        },
        "timeout": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
        },
        "min_severity": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Severity"
        },
        "include": {
          "type": "array",
          "items": {
            "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/WaitInclude"
          },
          "uniqueItems": true
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "until",
        "timeout"
      ]
    },
    "StreamOpenParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "min_severity": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Severity"
        },
        "include": {
          "type": "array",
          "items": {
            "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/WaitInclude"
          },
          "uniqueItems": true
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "contract_id"
      ]
    },
    "AttentionAckParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attention_id": {
          "type": "string",
          "pattern": "^attn_[A-Za-z0-9_-]+$"
        },
        "action": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/AckAction"
        },
        "actor": {
          "type": "string"
        },
        "snooze_for": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
        },
        "comment": {
          "type": "string"
        }
      },
      "required": [
        "attention_id",
        "action"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "snooze"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "snooze_for"
            ]
          },
          "else": {
            "not": {
              "required": [
                "snooze_for"
              ]
            }
          }
        }
      ]
    },
    "StatusParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "state",
              "delivery",
              "recent_events",
              "metrics"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "contract_id"
      ]
    },
    "ObservationQueryParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "subject_ref": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExAPUri"
        },
        "signal": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        },
        "since": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/DateTime"
        },
        "until": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/DateTime"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": []
    },
    "DiscoverResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-capability.schema.json"
        }
      },
      "required": [
        "capability"
      ]
    },
    "ContractCreateResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "status": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/LifecycleStatus"
        },
        "effective_contract": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-attention-contract.schema.json"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": [
        "contract_id",
        "status",
        "effective_contract"
      ]
    },
    "ContractGetResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-attention-contract.schema.json"
        },
        "state": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "contract"
      ]
    },
    "ContractListResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-attention-contract.schema.json"
          }
        },
        "next_cursor": {
          "type": "string"
        }
      },
      "required": [
        "contracts"
      ]
    },
    "ContractUpdateResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "status": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/LifecycleStatus"
        },
        "effective_contract": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-attention-contract.schema.json"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": [
        "contract_id",
        "status",
        "effective_contract"
      ]
    },
    "ContractPauseResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "status": {
          "const": "paused"
        }
      },
      "required": [
        "contract_id",
        "status"
      ]
    },
    "ContractResumeResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "status": {
          "const": "active"
        }
      },
      "required": [
        "contract_id",
        "status"
      ]
    },
    "ContractRevokeResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "status": {
          "const": "revoked"
        }
      },
      "required": [
        "contract_id",
        "status"
      ]
    },
    "WaitResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^act_[A-Za-z0-9_-]+$"
        },
        "return_reason": {
