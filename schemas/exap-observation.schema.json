{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exap.dev/schemas/exap-observation.schema.json",
  "title": "ExAP Observation",
  "type": "object",
  "required": [
    "observation_id",
    "subject_ref",
    "signal",
    "value",
    "observed_at",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "subject_ref": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/ExAPUri"
    },
    "signal": {
      "type": "string"
    },
    "value": {},
    "observed_at": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/DateTime"
    },
    "source": {
      "type": "string"
    },
    "quality": {
      "type": "object",
      "additionalProperties": true
    },
    "privacy": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/PrivacyReport"
    },
    "trace": {
      "$ref": "https://exap.dev/schemas/exap-common.schema.json#/$defs/TraceContext"
    }
  }
}
