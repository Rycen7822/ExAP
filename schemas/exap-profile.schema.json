{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exap.dev/schemas/0.2.0-draft/exap-profile.schema.json",
  "title": "ExAP Domain Profile",
  "type": "object",
  "required": [
    "profile_id",
    "exap_version",
    "name",
    "description",
    "domain",
    "subject_types",
    "rules",
    "delivery",
    "privacy"
  ],
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "type": "string",
      "pattern": "^profile:[a-z0-9_.:-]+$"
    },
    "exap_version": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExAPVersion"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "subject_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "event_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-rule.schema.json"
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "modes",
        "return_policy"
      ],
      "additionalProperties": true
    },
    "privacy": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/PrivacyPolicy"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "required",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "duration",
              "datetime",
              "array",
              "object"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "description": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExtensionMap"
    },
    "parameter_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "paths"
        ],
        "additionalProperties": false,
        "properties": {
          "parameter": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    }
  }
}
