{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exap.dev/schemas/0.2.0-draft/exap-rule.schema.json",
  "title": "ExAP Rule",
  "type": "object",
  "required": [
    "rule_id",
    "name",
    "condition",
    "severity"
  ],
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "condition": {
      "$ref": "#/$defs/Condition"
    },
    "severity": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Severity"
    },
    "category": {
      "type": "string"
    },
    "delivery_action": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/DeliveryAction"
    },
    "debounce": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
    },
    "cooldown": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
    },
    "hysteresis": {
      "type": "object",
      "required": [
        "recover_when",
        "emit_recovery_event"
      ],
      "additionalProperties": false,
      "properties": {
        "recover_when": {
          "$ref": "#/$defs/Condition"
        },
        "emit_recovery_event": {
          "type": "boolean"
        }
      }
    },
    "evidence": {
      "$ref": "#/$defs/EvidencePolicy"
    },
    "labels": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/KeyValue"
    },
    "metadata": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExtensionMap"
    }
  },
  "$defs": {
    "Condition": {
      "oneOf": [
        {
          "$ref": "#/$defs/AllCondition"
        },
        {
          "$ref": "#/$defs/AnyCondition"
        },
        {
          "$ref": "#/$defs/NotCondition"
        },
        {
          "$ref": "#/$defs/SignalCondition"
        },
        {
          "$ref": "#/$defs/EventCondition"
        },
        {
          "$ref": "#/$defs/StateCondition"
        },
        {
          "$ref": "#/$defs/CorrelationCondition"
        }
      ]
    },
    "AllCondition": {
      "type": "object",
      "required": [
        "type",
        "conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "all"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Condition"
          }
        }
      }
    },
    "AnyCondition": {
      "type": "object",
      "required": [
        "type",
        "conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "any"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Condition"
          }
        }
      }
    },
    "NotCondition": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "not"
        },
        "condition": {
          "$ref": "#/$defs/Condition"
        }
      }
    },
    "SignalOperator": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/SignalOperator"
    },
    "Aggregate": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Aggregate"
    },
    "SignalCondition": {
      "type": "object",
      "required": [
        "type",
        "signal",
        "operator"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "signal"
        },
        "subject_ref": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExAPUri"
        },
        "signal": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "operator": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/SignalOperator"
        },
        "value": {},
        "window": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
        },
        "aggregate": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Aggregate"
        },
        "duration": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
        },
        "missing": {
          "type": "string",
          "enum": [
            "unknown",
            "false",
            "true",
            "error"
          ]
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "semantic_model_ref": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "regex",
                  "contains",
                  "in",
                  "not_in",
                  "rate_gt",
                  "rate_lt",
                  "relative_change_gt",
                  "relative_change_lt",
                  "relative_drop_gt",
                  "semantic_match"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "exists",
                  "not_exists",
                  "changed",
                  "unchanged"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "rate_gt",
                  "rate_lt",
                  "relative_change_gt",
                  "relative_change_lt",
                  "relative_drop_gt"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "window"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "regex",
                  "contains"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "gt",
                  "gte",
                  "lt",
                  "lte"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": [
                      "number",
                      "integer"
                    ]
                  },
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "rate_gt",
                  "rate_lt",
                  "relative_change_gt",
                  "relative_change_lt",
                  "relative_drop_gt"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "integer"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "semantic_match"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "EventOperator": {
      "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/EventOperator"
    },
    "FieldFilter": {
      "type": "object",
      "required": [
        "path",
        "operator",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "operator": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/FieldOperator"
        },
        "value": {},
        "case_sensitive": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "regex",
                  "contains"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "semantic_match"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "EventCondition": {
      "type": "object",
      "required": [
        "type",
        "event_type",
        "operator"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "event"
        },
        "subject_ref": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/ExAPUri"
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "operator": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/EventOperator"
        },
        "value": {},
        "window": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldFilter"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "count_eq",
                  "count_gt",
                  "count_gte",
                  "count_lt",
                  "count_lte",
                  "semantic_match"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "exists"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "count_eq",
                  "count_gt",
                  "count_gte",
                  "count_lt",
                  "count_lte"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "integer",
                  "number"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "field_eq",
                  "field_regex",
                  "field_contains"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "filters"
            ],
            "properties": {
              "filters": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "semantic_match"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "StateCondition": {
      "type": "object",
      "required": [
        "type",
        "state_path",
        "operator"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "state"
        },
        "state_path": {
          "type": "string"
        },
        "operator": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/SignalOperator"
        },
        "value": {},
        "window": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "eq",
                  "ne",
                  "gt",
                  "gte",
                  "lt",
                  "lte",
                  "regex",
                  "contains",
                  "in",
                  "not_in",
                  "rate_gt",
                  "rate_lt",
                  "relative_change_gt",
                  "relative_change_lt",
                  "relative_drop_gt",
                  "semantic_match"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "exists",
                  "not_exists",
                  "changed",
                  "unchanged"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": [
                  "rate_gt",
                  "rate_lt",
                  "relative_change_gt",
                  "relative_change_lt",
                  "relative_drop_gt"
                ]
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "required": [
              "window"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "const": "semantic_match"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "CorrelationCondition": {
      "type": "object",
      "required": [
        "type",
        "mode",
        "within",
        "conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "correlation"
        },
        "mode": {
          "type": "string",
          "enum": [
            "all_within_window",
            "any_within_window",
            "ordered_sequence"
          ]
        },
        "within": {
          "$ref": "https://exap.dev/schemas/0.2.0-draft/exap-common.schema.json#/$defs/Duration"
        },
        "conditions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "alias",
              "condition"
            ],
            "additionalProperties": false,
            "properties": {
              "alias": {
                "type": "string"
              },
              "condition": {
                "$ref": "#/$defs/Condition"
              }
            }
          }
        }
      }
    },
    "EvidencePolicy": {
      "type": "object",
      "required": [
        "include"
      ],
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "matched_values",
              "window_stats",
              "event_excerpt",
              "log_excerpt",
              "subject_snapshot",
              "trace_link",
              "redaction_report",
              "semantic_score"
            ]
          },
          "uniqueItems": true
        },
        "max_items": {
          "type": "integer",
          "minimum": 0
        },
        "max_excerpt_chars": {
          "type": "integer",
          "minimum": 0
        },
        "include_subject_attributes": {
          "type": "boolean"
        }
      }
    }
  }
}
