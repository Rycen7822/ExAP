      "secret"
    ]
  },
  "integrations": {
    "mcp": {
      "tools": [
        "eap_discover",
        "eap_contract_create",
        "eap_wait",
        "eap_status",
        "eap_attention_ack",
        "eap_contract_revoke"
      ]
    },
    "a2a": {
      "artifact_type": "application/eap+json"
    }
  }
}
