{
  "eap_version": "0.2.0-draft",
  "contract_id": "act_process_wait_001",
  "created_at": "2026-05-16T12:00:00+09:00",
  "consumer": {
    "consumer_id": "agent:codex-local",
    "type": "agent",
    "display_name": "Codex local agent",
    "capabilities": {
      "blocking_wait": true,
      "mcp": true
    }
  },
  "provider": {
    "provider_id": "local-process-provider",
    "type": "local_daemon",
    "version": "0.2.0"
  },
  "environment_ref": "eap://local/machine/workstation-01",
  "intent": "monitor_long_running_process_without_polling",
  "scope": {
    "subjects": [
      {
        "type": "process",
        "ref": "eap://local/process/18423",
        "include_children": true,
        "resolution": "exact"
      },
      {
        "type": "gpu",
        "ref": "eap://local/gpu/0",
        "resolution": "exact"
      }
    ],
    "signals": [
      "process.status",
      "process.exit_code",
      "process.cpu.percent",
      "process.memory.rss_mb",
      "gpu.util.percent",
      "gpu.memory.used_mb",
      "log.line",
      "disk.free_gb"
    ],
    "events": [
      "process.exited",
      "log.line.appended",
      "file.created"
    ]
  },
  "delivery": {
    "modes": [
      "blocking_wait",
      "stream"
    ],
    "transports": [
      {
        "transport": "mcp",
        "mode": "blocking_wait",
        "content_mode": "structured",
        "metadata": {
          "tool": "eap_wait"
        }
      },
      {
        "transport": "sse",
        "mode": "stream",
        "endpoint": "http://127.0.0.1:8765/eap/contracts/act_process_wait_001/stream",
        "content_mode": "structured"
      }
    ],
    "return_policy": {
      "default_action": "record_only",
      "by_severity": {
        "info": "include_in_summary",
        "notice": "deliver",
        "warning": "deliver_and_interrupt_wait",
        "critical": "deliver_and_interrupt_wait",
        "emergency": "deliver_and_interrupt_wait"
      }
    },
    "dedupe": {
      "key_fields": [
        "contract_id",
        "rule_id",
        "subject.ref"
      ],
      "window": "PT10M"
    },
    "retry": {
      "max_attempts": 0,
      "backoff": "none"
    },
    "ack": {
      "required": false,
      "deadline": "PT0S",
      "snooze_allowed": true
    },
    "payload_limits": {
      "max_event_bytes": 32768,
      "max_evidence_items": 8,
      "max_text_chars": 4000
    }
  },
  "privacy": {
    "purpose": "environment_attention",
    "data_minimization": true,
    "allowed_fields": [
      "subject.ref",
      "subject.type",
      "evidence.stats",
      "evidence.value",
      "payload.summary"
    ],
    "forbidden_fields": [
      "secret",
      "token",
      "password",
      "credential",
      "payload.raw_body",
      "payload.attachment.content"
    ],
    "redaction": {
      "mode": "summary_only",
      "include_redaction_report": true,
      "rules": []
    },
    "retention": {
      "observations": "PT24H",
      "events": "P7D",
      "audit_logs": "P30D"
    },
    "audit": {
      "enabled": true,
      "user_visible": true,
      "log_fields": [
        "contract_id",
        "attention_id",
        "rule_id",
        "delivery_action"
      ]
    },
    "data_classes": [
      "operational_metadata"
    ]
  },
  "lifecycle": {
    "status": "active",
    "starts_at": "2026-05-16T12:00:00+09:00",
    "expires_at": "2026-05-17T12:00:00+09:00",
    "max_runtime": "P1D",
    "auto_revoke_on_completion": true
  },
  "memory": {
    "allowed": true,
    "scope": "session",
    "allowed_keys": [
      "contract_id",
      "last_attention_id",
      "last_status"
